@model DishCategory_BIT240081
@{
    ViewData["Title"] = L["Title_CategoryCreate"];
}

<h1 class="mb-3">@L["Title_CategoryCreate"]</h1>

<form asp-action="Create" method="post" class="card card-body">
    <partial name="_CategoryForm" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Btn_Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
