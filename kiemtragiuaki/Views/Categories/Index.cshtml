@model List<DishCategory_BIT240081>
@{
    ViewData["Title"] = L["Title_CategoryList"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["Title_CategoryList"]</h1>
    <a class="btn btn-primary" asp-action="Create">+ @L["Btn_CreateCategory"]</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">@L["Msg_NoCategories"]</div>
}
else
{
    <div class="surface p-2 table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>@L["Field_Id"]</th>
                <th>@L["Field_Name"]</th>
                <th>@L["Field_Description"]</th>
                <th class="text-end">@L["Field_DishCount"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td class="fw-semibold">
                        <a asp-controller="Dishes" asp-action="Index" asp-route-categoryId="@c.Id">@c.Name</a>
                    </td>
                    <td>@c.Description</td>
                    <td class="text-end">@c.Dishes.Count</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">@L["Btn_Edit"]</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">@L["Btn_Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
