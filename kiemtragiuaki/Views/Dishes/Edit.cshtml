@model Dish_BIT240081
@{
    ViewData["Title"] = L["Title_DishEdit"];
}

<h1 class="mb-3">@L["Title_DishEdit"]: @Model.Name</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
    <input type="hidden" asp-for="Id" />
    <partial name="_DishForm" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">@L["Btn_Details"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Btn_Back"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
